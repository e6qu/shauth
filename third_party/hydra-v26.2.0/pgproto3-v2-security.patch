@@ -0,0 +1,16 @@
+package pgproto3
+
+import "testing"
+
+func TestSecurityBackportNegativeFieldLength(t *testing.T) {
+	for _, data := range [][]byte{{0, 1, 255, 255, 255, 254}, {0, 1, 128, 0, 0, 0}} {
+		var row DataRow
+		if err := row.Decode(data); err == nil {
+			t.Fatal("negative non-null field length accepted")
+		}
+	}
+	var row DataRow
+	if err := row.Decode([]byte{0, 1, 255, 255, 255, 255}); err != nil || len(row.Values) != 1 || row.Values[0] != nil {
+		t.Fatalf("SQL NULL rejected: %v", err)
+	}
+}
