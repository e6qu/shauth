+++ b/security_backport_test.go
@@ -0,0 +1,38 @@
+package jose
+
+import (
+	"encoding/base64"
+	"github.com/go-jose/go-jose/v3/json"
+	"math/big"
+	"strings"
+	"testing"
+)
+
+func TestSecurityBackportRSABounds(t *testing.T) {
+	n := base64.RawURLEncoding.EncodeToString(new(big.Int).Lsh(big.NewInt(1), 4096).Bytes())
+	var key JSONWebKey
+	if err := json.Unmarshal([]byte(`{"kty":"RSA","n":"`+n+`","e":"AQAB"}`), &key); err == nil || !strings.Contains(err.Error(), "modulus too large") {
+		t.Fatalf("oversized modulus accepted: %v", err)
+	}
+	if err := json.Unmarshal([]byte(`{"kty":"RSA","n":"Dw","e":"Aw","d":"Aw","p":"Bw","q":"Bw"}`), &key); err == nil || !strings.Contains(err.Error(), "p * q != n") {
+		t.Fatalf("degenerate primes reached validation: %v", err)
+	}
+}
+
+func TestSecurityBackportEmbeddedPrivateKeys(t *testing.T) {
+	// Private parameters must be rejected before their RSA validation, including
+	// general JWS unprotected headers and JWE ephemeral key headers.
+	key := `{"kty":"RSA","n":"Dw","e":"Aw","d":"Aw","p":"Bw","q":"Bw"}`
+	for _, message := range []string{
+		`{"payload":"e30","signature":"AA","header":{"alg":"RS256","jwk":` + key + `}}`,
+		`{"payload":"e30","signatures":[{"signature":"AA","header":{"alg":"RS256","jwk":` + key + `}}]}`,
+	} {
+		if _, err := ParseSigned(message); err == nil || !strings.Contains(err.Error(), "private parameters") {
+			t.Fatalf("private JWS key was not rejected before validation: %v", err)
+		}
+	}
+	raw := json.RawMessage(key)
+	if _, err := (rawHeader{headerEPK: &raw}).getEPK(); err == nil || !strings.Contains(err.Error(), "private parameters") {
+		t.Fatalf("private EPK was not rejected before validation: %v", err)
+	}
+}
