# SPDX-License-Identifier: AGPL-3.0-or-later
# The Go image comes from the Amazon ECR Public copy of Docker's official images,
# pinned to the same index digest Docker Hub serves: Docker Hub limits anonymous
# pulls per address, and the shared CI runners exhaust it.
FROM public.ecr.aws/docker/library/golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
# The leveled logging helpers, so the validator's container stream carries the
# same severities as every other binary. The package is standard library only,
# so this keeps the image as small as the narrow copy it joins.
COPY internal/observe ./internal/observe
COPY cmd/shauth-validator ./cmd/shauth-validator
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/shauth-validator ./cmd/shauth-validator

# The Node image comes from the Amazon ECR Public copy of Docker's official images,
# pinned to the same index digest Docker Hub serves: Docker Hub limits anonymous
# pulls per address, and the shared CI runners exhaust it.
FROM public.ecr.aws/docker/library/node:26.10.0-bookworm-slim@sha256:3ffc19ea878019d9e9ae8971732ad4a03cda44f167107173174b60ed7c65bed3
WORKDIR /opt/shauth-validator
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
COPY package.json package-lock.json ./
# Chromium's system packages come from the Debian mirror. A stalled mirror
# connection is retried and the whole install is bounded, so a slow mirror
# fails the build with a clear error instead of exhausting the CI job.
RUN printf 'Acquire::Retries "3";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/80-bounded-downloads
RUN npm ci && timeout 600 npx playwright install --with-deps chromium && npm cache clean --force
COPY validator/validate.mjs validator/application-ui.mjs validator/security.mjs validator/readiness.mjs ./
COPY --from=build /out/shauth-validator /usr/local/bin/shauth-validator
ENV SHAUTH_VALIDATOR_SCRIPT=/opt/shauth-validator/validate.mjs
RUN chown -R node:node /ms-playwright /opt/shauth-validator
USER node
ENTRYPOINT ["/usr/local/bin/shauth-validator"]
